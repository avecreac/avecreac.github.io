{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 600,
  "height": 350,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "title": {
    "text": "Lithium exports and EV car sales, Eastern and Southeastern Asia",
    "subtitle": [
      "2010-2024. Lithium exports to the world, current US dollars (left axis).",
      "EV car sales, millions of cars (right axis)."
    ],
    "subtitleColor": "#666",
    "anchor": "start"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/avecreac/avecreac.github.io/refs/heads/main/critical_minerals_tidy.csv"
      },
      "transform": [
        {
          "filter": "datum.product == 'Lithium' && datum.year >= 2010"
        }
      ],
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "axis": {
            "format": "d",
            "values": [
              2010,
              2012,
              2014,
              2016,
              2018,
              2020,
              2022,
              2024
            ]
          },
          "scale": {
            "domain": [
              2010,
              2024
            ]
          }
        },
        "y": {
          "field": "value_usd_bn",
          "type": "quantitative",
          "scale": {
            "zero": true
          },
          "axis": {
            "title": "Lithium exports (USD bn)",
            "titleColor": "#675193",
            "labelColor": "#675193"
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "line",
            "color": "#675193",
            "point": {
              "color": "#675193",
              "filled": true
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.year == 2023"
            },
            {
              "calculate": "'$' + format(datum.value_usd_bn, '.1f') + 'bn'",
              "as": "label"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -10,
            "dy": 0,
            "fontWeight": "bold",
            "color": "#675193"
          },
          "encoding": {
            "text": {
              "field": "label",
              "type": "nominal"
            }
          }
        }
      ]
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/avecreac/avecreac.github.io/refs/heads/main/ev_sales_tidy.csv"
      },
      "transform": [
        {
          "filter": "datum.region == 'East & SE Asia (approx.)' && datum.year <= 2024"
        }
      ],
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "axis": {
            "format": "d",
            "values": [
              2010,
              2012,
              2014,
              2016,
              2018,
              2020,
              2022,
              2024
            ]
          },
          "scale": {
            "domain": [
              2010,
              2024
            ]
          }
        },
        "y": {
          "field": "ev_sales_million",
          "type": "quantitative",
          "scale": {
            "zero": true
          },
          "axis": {
            "title": "EV car sales (millions)",
            "titleColor": "#ca8861",
            "labelColor": "#ca8861",
            "orient": "right"
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "line",
            "color": "#ca8861",
            "point": {
              "color": "#ca8861",
              "filled": true
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.year == 2024"
            },
            {
              "calculate": "format(datum.ev_sales_million, '.1f') + 'm'",
              "as": "label"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -10,
            "dy": -4,
            "fontWeight": "bold",
            "color": "#ca8861"
          },
          "encoding": {
            "text": {
              "field": "label",
              "type": "nominal"
            }
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "y": "independent"
    }
  }
}