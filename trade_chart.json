{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 600,
  "height": 350,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": ["Exports and Imports Goods in Indonesia", "2000-2025"],
  "data": {
    "url": "https://raw.githubusercontent.com/avecreac/avecreac.github.io/refs/heads/main/trade_in_goods_tidy.csv"
  },
  "transform": [
    {"filter": "datum.iso3 == 'idn' && datum.year >= 2000"},
    {"fold": ["Exports (USD bn)", "Imports (USD bn)"], "as": ["flow", "value"]}
  ],
  "mark": {"type": "line", "point": true},
  "encoding": {
    "x": {"field": "year", "type": "quantitative", "axis": {"format": "d"}, "title": null},
    "y": {"field": "value", "type": "quantitative", "title": "USD billions"},
    "color": {
      "field": "flow",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": ["Exports (USD bn)", "Imports (USD bn)"],
        "range": ["#675193", "#ca8861"]
      }
    }
  }
}